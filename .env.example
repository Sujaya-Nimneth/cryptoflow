# Supabase cloud storage is optional. Device-local storage works without it.
# Use the project URL and publishable key only. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only market proxy configuration. Never prefix secrets with NEXT_PUBLIC_.
# CRYPTO_API_URL=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=
